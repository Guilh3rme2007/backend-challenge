{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start:dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:all": "bun test",
    "migration:up": "bun src/migrations/run.ts up",
    "migration:down": "bun src/migrations/run.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1159.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/bun": "1.2.5",
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "typescript": "5.7.3"
  },
  "overrides": {
    "ajv": "8.20.0",
    "js-yaml": "5.5.0",
    "multer": "2.5.0"
  }
}
